# 复制为 .env 后填写真实值；.env 不提交
DATABASE_URL=mysql+aiomysql://root:<password>@127.0.0.1:3306/trade_order?charset=utf8mb4
# 测试库，tests 会在其中建表并清空数据
TEST_DATABASE_URL=mysql+aiomysql://root:<password>@127.0.0.1:3306/trade_order_test?charset=utf8mb4
JWT_SECRET=<random-string>
JWT_EXPIRE_MINUTES=480

# 文本模型（DeepSeek，OpenAI 兼容接口）
DEEPSEEK_API_KEY=<deepseek-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 视觉模型（阿里云百炼，兼容模式）
DASHSCOPE_API_KEY=<dashscope-key>
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3-vl-plus

LLM_TIMEOUT_SECONDS=30
# 模型请求默认不走系统代理；需要经代理访问时改为 true
LLM_USE_SYSTEM_PROXY=false
